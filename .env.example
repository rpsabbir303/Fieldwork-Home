# Neon pooled URL for application queries. Replace every placeholder locally.
DATABASE_URL="postgresql://USER:ENCODED_PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Matching direct Neon URL for Prisma migrations; do not use the pooled host here.
DIRECT_URL="postgresql://USER:ENCODED_PASSWORD@ep-example.REGION.aws.neon.tech/DBNAME?sslmode=require"
# 32+ random characters; required for signed admin sessions.
SESSION_SECRET="replace-with-a-long-random-value-at-least-32-characters"
# Used only by the one-time admin creation command. Do not commit real values.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Set to your deployed HTTPS origin for canonical metadata and sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional, shown on the contact page if supplied.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Set separately per deployment: public or admin. Leave unset for local combined development.
APP_MODE=""
# Admin deployment only. Exact admin hostname without scheme or port, once assigned.
ADMIN_HOSTNAME=""
# Admin deployment only. Google Analytics 4 Data API service account with property read access.
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""
# Admin deployment only. Google PageSpeed Insights API key.
PAGESPEED_API_KEY=""
